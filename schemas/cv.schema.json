{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tailored CV document (cv.json)",
  "description": "Render-ready content of one tailored CV. Every bullet and list item should carry the profile ids it was derived from in `source`.",
  "type": "object",
  "required": ["schemaVersion", "meta", "header", "sections"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "meta": {
      "type": "object",
      "required": ["language", "paper", "market"],
      "properties": {
        "language": { "type": "string", "minLength": 2 },
        "paper": { "enum": ["A4", "Letter"] },
        "market": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "targetPages": { "type": "integer", "minimum": 1, "maximum": 4 },
        "fontSize": { "type": "number", "minimum": 9, "maximum": 12 },
        "title": { "type": "string" }
      }
    },
    "header": {
      "type": "object",
      "required": ["name", "contact"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "headline": { "type": "string" },
        "contact": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "details": { "type": "array", "items": { "type": "string" } }
      }
    },
    "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/section" } }
  },
  "$defs": {
    "source": { "type": "array", "items": { "type": "string" } },
    "item": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["text"],
          "properties": {
            "text": { "type": "string", "minLength": 1 },
            "source": { "$ref": "#/$defs/source" }
          }
        }
      ]
    },
    "entry": {
      "type": "object",
      "required": ["heading"],
      "properties": {
        "heading": { "type": "string" },
        "subheading": { "type": "string" },
        "location": { "type": "string" },
        "dates": { "type": "string" },
        "summary": { "type": "string" },
        "bullets": { "type": "array", "items": { "$ref": "#/$defs/item" } },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "group": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "label": { "type": "string" },
        "items": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "section": {
      "type": "object",
      "required": ["kind", "title"],
      "properties": {
        "kind": { "enum": ["text", "entries", "groups", "list"] },
        "title": { "type": "string", "minLength": 1 },
        "text": { "type": "string" },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
        "groups": { "type": "array", "items": { "$ref": "#/$defs/group" } },
        "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "text" } } }, "then": { "required": ["text"] } },
        { "if": { "properties": { "kind": { "const": "entries" } } }, "then": { "required": ["entries"] } },
        { "if": { "properties": { "kind": { "const": "groups" } } }, "then": { "required": ["groups"] } },
        { "if": { "properties": { "kind": { "const": "list" } } }, "then": { "required": ["items"] } }
      ]
    }
  }
}
